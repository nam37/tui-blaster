{
  "name": "tui-blaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Battlezone-inspired OpenTUI and Three.js terminal tank game.",
  "scripts": {
    "start": "node scripts/run-bun.mjs run src/index.ts",
    "simulate": "tsx src/simulate.ts",
    "smoke:bun": "node scripts/run-bun.mjs run src/smoke.ts",
    "test": "tsx src/game/game.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.3.1",
    "three": "0.177.0"
  },
  "devDependencies": {
    "@opentui/core-win32-x64": "^0.3.1",
    "@oven/bun-windows-x64": "^1.3.14",
    "@types/node": "^24.0.0",
    "@types/three": "^0.177.0",
    "bun": "^1.3.14",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  }
}
